APP_NAME=StarCurrecy
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-app-name.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Database (Render PostgreSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=your-render-postgres-host
DB_PORT=5432
DB_DATABASE=starcurrecy
DB_USERNAME=your_render_db_user
DB_PASSWORD=your_render_db_password
DB_SCHEMA=public
DB_SSLMODE=require
DB_URL=postgresql://your_render_db_user:your_render_db_password@your-render-postgres-host:5432/starcurrecy?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@starcurrecy.com"
MAIL_FROM_NAME="${APP_NAME}"

STARCURRECY_SUPPORT_EMAIL=support@starcurrecy.com
